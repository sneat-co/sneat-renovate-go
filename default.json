{
  "extends": [
    "config:base",
    ":semanticCommits",
    ":automergeMinor"
  ],
  "env": {
    "GOPRIVATE": "github.com/sneat-co/*",
    "GONOPROXY": "github.com/sneat-co/*",
    "GONOSUMDB": "github.com/sneat-co/*"
  },
  "timezone": "Europe/Dublin",
  "platformAutomerge": true,
  "hostRules": [
    {
      "matchHost": "https://github.com/sneat-co",
      "hostType": "go",
      "token": "{{ secrets.RENOVATE_GITHUB_COM_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "groupName": "go toolchain",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang"],
      "separateMinorPatch": true,
      "separateMultipleMajor": true,
      "automerge": false
    },
    {
      "groupName": "go toolchain patches",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "groupName": "sneat non major deps",
      "groupSlug": "sneat-minor-patch",
      "description": "Own libraries (dal-go, strongo, sneat-co) are never gated by a consumer's schedule or release-age policy: the fleet must be on the latest release always (founder rule 2026-09-02).",
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": null,
      "matchPackagePatterns": [
        "github.com/dal-go/",
        "github.com/strongo/",
        "github.com/sneat-co/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeSchedule": [
        "after 4am and before 6am"
      ],
      "platformAutomerge": false
    },
    {
      "groupName": "3d-parties non major deps",
      "groupSlug": "3d-parties-minor-patch",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
